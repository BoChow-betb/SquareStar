SQUARESTAR_RESOURCE_PROJECT_LICENSE RCDATA "@SQUARESTAR_PROJECT_LICENSE_PATH@"
SQUARESTAR_RESOURCE_THIRD_PARTY_NOTICES RCDATA "@SQUARESTAR_THIRD_PARTY_NOTICES_PATH@"
SQUARESTAR_RESOURCE_ASSET_CREDITS RCDATA "@SQUARESTAR_ASSET_CREDITS_PATH@"
SQUARESTAR_RESOURCE_PRIVACY_NOTICE RCDATA "@SQUARESTAR_PRIVACY_NOTICE_PATH@"
SQUARESTAR_RESOURCE_DATA_PROVIDER_NOTICE RCDATA "@SQUARESTAR_DATA_PROVIDER_NOTICE_PATH@"
SQUARESTAR_RESOURCE_DEAR_IMGUI_LICENSE RCDATA "@SQUARESTAR_LICENSE_DIR@/Dear-ImGui.txt"
