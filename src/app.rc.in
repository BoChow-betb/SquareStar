#include "platform/embedded_resource_ids.h"
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Bo Blitz Chow\0"
            VALUE "FileDescription", "SquareStar\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "SquareStar\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Bo Blitz Chow\0"
            VALUE "OriginalFilename", "SquareStar.exe\0"
            VALUE "ProductName", "SquareStar\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

101 ICON "@SQUARESTAR_ICON_PATH@"
@SQUARESTAR_MANIFEST_RESOURCE@

// Runtime assets use numeric identifiers so both MSVC rc.exe and GNU windres
// can parse consecutive file-backed resources unambiguously.
SQUARESTAR_RESOURCE_KEY_WAV RCDATA "@SQUARESTAR_SOUND_KEY@"
SQUARESTAR_RESOURCE_CLICK_WAV RCDATA "@SQUARESTAR_SOUND_CLICK@"
SQUARESTAR_RESOURCE_DECLINE_WAV RCDATA "@SQUARESTAR_SOUND_DECLINE@"
SQUARESTAR_RESOURCE_ERROR_WAV RCDATA "@SQUARESTAR_SOUND_ERROR@"
SQUARESTAR_RESOURCE_GAIN_WAV RCDATA "@SQUARESTAR_SOUND_GAIN@"
SQUARESTAR_RESOURCE_LAUNCH_WAV RCDATA "@SQUARESTAR_SOUND_LAUNCH@"
SQUARESTAR_RESOURCE_LOADING_WAV RCDATA "@SQUARESTAR_SOUND_LOADING@"
SQUARESTAR_RESOURCE_LOSS_WAV RCDATA "@SQUARESTAR_SOUND_LOSS@"
SQUARESTAR_RESOURCE_MARKET_OPEN_CLOSE_WAV RCDATA "@SQUARESTAR_SOUND_MARKET_OPEN_CLOSE@"
SQUARESTAR_RESOURCE_OFF_WAV RCDATA "@SQUARESTAR_SOUND_OFF@"
SQUARESTAR_RESOURCE_ON_WAV RCDATA "@SQUARESTAR_SOUND_ON@"
SQUARESTAR_RESOURCE_TRANSITION_WAV RCDATA "@SQUARESTAR_SOUND_TRANSITION@"

SQUARESTAR_RESOURCE_OUTFIT_BOLD_TTF RCDATA "@SQUARESTAR_ASSET_DIR@/Outfit-Bold.ttf"
SQUARESTAR_RESOURCE_OUTFIT_MEDIUM_TTF RCDATA "@SQUARESTAR_ASSET_DIR@/Outfit-Medium.ttf"
SQUARESTAR_RESOURCE_OUTFIT_REGULAR_TTF RCDATA "@SQUARESTAR_ASSET_DIR@/Outfit-Regular.ttf"
SQUARESTAR_RESOURCE_OUTFIT_SEMIBOLD_TTF RCDATA "@SQUARESTAR_ASSET_DIR@/Outfit-SemiBold.ttf"

