root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h,hpp}]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{cmake,txt}]
end_of_line = lf
indent_style = space
indent_size = 4

[CMakeLists.txt]
end_of_line = lf
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
end_of_line = lf
indent_style = space
indent_size = 2

[*.md]
end_of_line = lf
trim_trailing_whitespace = false

[*.{cmd,ps1}]
end_of_line = crlf
indent_style = space
indent_size = 4
