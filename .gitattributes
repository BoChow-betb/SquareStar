* text=auto

# Source and documentation are normalized to LF in the repository.
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.manifest text eol=lf
*.in text eol=lf

# Windows-native developer entry points keep CRLF checkouts.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.ico binary
*.wav binary
*.ttf binary
